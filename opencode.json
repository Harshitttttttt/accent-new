{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 60000
    },
    "servers": {
      "Neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp?readonly=true&projectId=icy-boat-74530454"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
          "@playwright/mcp@latest"
        ]
      },
      "shadcn": {
        "type": "local",
        "command": ["pnpm", "exec", "shadcn", "mcp"]
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "cloudflare-bindings": {
        "type": "remote",
        "url": "https://bindings.mcp.cloudflare.com/mcp"
      },
      "cloudflare-builds": {
        "type": "remote",
        "url": "https://builds.mcp.cloudflare.com/mcp"
      },
      "cloudflare-observability": {
        "type": "remote",
        "url": "https://observability.mcp.cloudflare.com/mcp"
      }
    }
  }
}
